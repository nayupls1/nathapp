{
  "name": "gapp",
  "productName": "gApp",
  "version": "0.1.0",
  "description": "Electron + SolidJS desktop app with a Bun backend server",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/build.ts",
    "start": "bun scripts/start.ts",
    "package": "bun run build && electron-builder",
    "server": "bun --watch src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "e2e": "bun scripts/e2e.ts",
    "check": "bun run typecheck && bun run test && bun run build && bun run e2e"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@tanstack/charts": "^1.1.0",
    "@types/bun": "^1.4.3",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "lucide-solid": "^1.57.0",
    "lucide-static": "^1.57.0",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "unplugin": "^2.3.11",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "zod": "^4.6.7"
  }
}
